# ==========================================
# 1. Environment & Secret Files (CRITICAL)
# ==========================================
# Ignores .env files anywhere in the repo (keeps API keys safe)
**/.env
**/.env.*
!.env.example

# ==========================================
# 2. Python Virtual Environments
# ==========================================
# Ignores venv folders in the root or any subfolder (e.g., services/session-ledger/venv)
**/venv/
**/.venv/
**/env/
**/ENV/

# ==========================================
# 3. Python Bytecode & Cache
# ==========================================
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================
# 4. Local Database & Log Files
# ==========================================
*.sqlite3
*.db
*.log
**/logs/

# ==========================================
# 5. IDE & Editor Files
# ==========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PyCharm
.idea/

# General Editors
*.swp
*.swo

# ==========================================
# 6. OS Generated Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthmb.db
Desktop.ini

# ==========================================
# 7. Distribution / Build Packages
# ==========================================
build/
devel/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg